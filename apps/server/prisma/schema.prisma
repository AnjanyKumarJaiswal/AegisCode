


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  username       String?
  passwordHash   String?
  githubId       String?          @unique
  githubToken    String?
  credits        Int              @default(100)
  sessions       CodingSession[]
  settings       UserSettings?
  profile        UserProfile?
  apiKeys        ApiKey[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model UserSettings {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  criticalAlerts Boolean          @default(true)
  weeklySummary  Boolean          @default(false)
  lastIdeClient  String?
  lastIdeSyncAt  DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ApiKey {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyPrefix    String
  keyHash      String
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([userId])
  @@index([keyPrefix])
}

model UserProfile {
  id             String           @id @default(uuid())
  userId         String           @unique
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String?
  role           String?
  bio            String?          @db.Text
  region         String           @default("local")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CodingSession {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         SessionStatus    @default(ACTIVE)
  currentScore   Float?
  ideClient      String?
  scans          ScanReport[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

model ScanReport {
  id             String           @id @default(uuid())
  sessionId      String
  session        CodingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggerType    ScanTrigger
  score          Float
  filePath       String?
  languageId     String?
  sourceContent  String?          @db.Text
  vulnerabilities Vulnerability[]
  createdAt      DateTime         @default(now())
}

enum ScanTrigger {
  AUTO_INACTIVITY
  MANUAL
}

model Vulnerability {
  id             String           @id @default(uuid())
  scanId         String
  scan           ScanReport       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category       String
  severity       Severity
  title          String
  description    String           @db.Text
  fileLocation   String
  lineNumber     Int?
  fixSuggestion  String           @db.Text
  status         VulnStatus       @default(OPEN)
  createdAt      DateTime         @default(now())
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum VulnStatus {
  OPEN
  FIXED
}
