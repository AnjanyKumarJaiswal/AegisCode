


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  username       String?
  passwordHash   String?
  githubId       String?          @unique
  githubToken    String?          
  credits        Int              @default(100) 
  sessions       CodingSession[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model CodingSession {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         SessionStatus    @default(ACTIVE)
  currentScore   Float?           
  scans          ScanReport[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

enum SessionStatus {
  ACTIVE
  COMPLETED
}

model ScanReport {
  id             String           @id @default(uuid())
  sessionId      String
  session        CodingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  triggerType    ScanTrigger
  score          Float            
  vulnerabilities Vulnerability[]
  createdAt      DateTime         @default(now())
}

enum ScanTrigger {
  AUTO_INACTIVITY
  MANUAL
}

model Vulnerability {
  id             String           @id @default(uuid())
  scanId         String
  scan           ScanReport       @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category       String           
  severity       Severity
  title          String
  description    String           @db.Text
  fileLocation   String           
  lineNumber     Int?
  fixSuggestion  String           @db.Text 
  status         VulnStatus       @default(OPEN)
  createdAt      DateTime         @default(now())
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum VulnStatus {
  OPEN
  FIXED
}
