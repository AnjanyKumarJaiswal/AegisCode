{
    "name": "aegiscode",
    "displayName": "AegisCode",
    "description": "AI Security Guardian — Real-time security scanning for AI-generated code",
    "version": "0.1.0",
    "publisher": "aegiscode",
    "license": "MIT",
    "engines": {
        "vscode": "^1.107.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onUri",
        "onView:aegiscode.panel",
        "onCommand:aegiscode.startSession",
        "onCommand:aegiscode.stopSession",
        "onCommand:aegiscode.scanNow",
        "onCommand:aegiscode.scanWorkspace",
        "onCommand:aegiscode.login",
        "onCommand:aegiscode.logout",
        "onCommand:aegiscode.signInGithub"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aegiscode",
                    "title": "AegisCode",
                    "icon": "./assets/icon.svg"
                }
            ]
        },
        "views": {
            "aegiscode": [
                {
                    "type": "webview",
                    "id": "aegiscode.panel",
                    "name": "AegisCode"
                }
            ]
        },
        "commands": [
            {
                "command": "aegiscode.startSession",
                "title": "AegisCode: Start Security Session"
            },
            {
                "command": "aegiscode.stopSession",
                "title": "AegisCode: Stop Security Session"
            },
            {
                "command": "aegiscode.scanNow",
                "title": "AegisCode: Scan Now"
            },
            {
                "command": "aegiscode.scanWorkspace",
                "title": "AegisCode: Scan Workspace"
            },
            {
                "command": "aegiscode.login",
                "title": "AegisCode: Sign In"
            },
            {
                "command": "aegiscode.logout",
                "title": "AegisCode: Sign Out"
            },
            {
                "command": "aegiscode.signInGithub",
                "title": "AegisCode: Sign In with GitHub"
            }
        ],
        "configuration": {
            "title": "AegisCode",
            "properties": {
                "aegiscode.serverUrl": {
                    "type": "string",
                    "default": "http://localhost:4000",
                    "description": "URL of the AegisCode backend server."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "node esbuild.config.js --production",
        "build": "node esbuild.config.js",
        "dev": "node esbuild.config.js --watch",
        "lint": "eslint src/",
        "clean": "rimraf dist node_modules",
        "package": "vsce package"
    },
    "dependencies": {
        "@aegiscode/shared": "*"
    },
    "devDependencies": {
        "@types/node": "^20",
        "@types/vscode": "1.107.0",
        "@vscode/vsce": "^3.7.1",
        "dotenv": "^17.3.1",
        "esbuild": "^0.24.0",
        "typescript": "^5"
    }
}
